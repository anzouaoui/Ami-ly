rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Refuse tout par défaut
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Photos de profil parent
    match /parents/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Photos de profil assistante maternelle
    match /assmats/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Contrats d'engagement réciproque et documents signés (PDF final).
    // Accès réservé aux deux parties au contrat (parent / assistante
    // maternelle) — le PDF signé par DocuSign est stocké sous
    // `contracts/{contractId}/`.
    function isContractParty(contractId, uid) {
      let contract = firestore
        .get(/databases/(default)/documents/contracts/$(contractId))
        .data;
      return contract != null &&
        (contract.parentUid == uid || contract.assmatUid == uid);
    }

    match /contracts/{contractId}/{allPaths=**} {
      allow read: if isContractParty(contractId, request.auth.uid);
      allow write: if isContractParty(contractId, request.auth.uid);
    }

  }
}
