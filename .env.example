# ──────────────────────────────────────────────────────────────
# Ami-ly — Variables d'environnement (injectées au build Flutter)
# ──────────────────────────────────────────────────────────────
# Copier ce fichier vers `.env` puis renseigner les valeurs.
# Ne JAMAIS committer le fichier `.env` (il est ignoré par git).
#
# Utilisation :
#   flutter run  --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
# ──────────────────────────────────────────────────────────────

# --- Firebase (Android) ---
# Console Firebase → Paramètres du projet → Vos applications → Android
FIREBASE_API_KEY_ANDROID=
FIREBASE_APP_ID_ANDROID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# --- Firebase (iOS) ---
# Console Firebase → Paramètres du projet → Vos applications → iOS
FIREBASE_API_KEY_IOS=
FIREBASE_APP_ID_IOS=
FIREBASE_IOS_BUNDLE_ID=com.app.amily

# --- Stripe (clé PUBLISHABLE uniquement — la clé secrète reste côté Cloud Functions) ---
# Dashboard Stripe → Développeurs → Clés API
STRIPE_PUBLISHABLE_KEY=

# --- RevenueCat (abonnement Ami-ly Pro) ---
# Dashboard RevenueCat → Projet → Clés API
REVENUECAT_API_KEY_ANDROID=
REVENUECAT_API_KEY_IOS=

# --- Agora (visioconférence) ---
# App ID uniquement côté client ; le certificat secret reste côté Cloud Functions.
# Dashboard Agora → Project Management
AGORA_APP_ID=
