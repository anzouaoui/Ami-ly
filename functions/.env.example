# ──────────────────────────────────────────────────────────────
# Ami-ly — Cloud Functions : variables d'environnement serveur
# ──────────────────────────────────────────────────────────────
# Copier ce fichier vers `functions/.env` puis renseigner les valeurs.
# Ne JAMAIS committer le fichier `.env` (ignoré par functions/.gitignore).
# Chargé automatiquement par firebase-functions v2 au déploiement :
#   firebase deploy --only functions
# ──────────────────────────────────────────────────────────────

# --- DocuSign (JWT) ---
# AppCenter DocuSign → Apps and Keys
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net
DOCUSIGN_BASE_URL=https://us-central1-ami-ly.cloudfunctions.net
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
# HMAC partagé pour vérifier les webhooks DocuSign Connect (x-docusign-signature-1)
DOCUSIGN_CONNECT_HMAC_KEY=

# --- Stripe (clés SECRÈTES — jamais côté client) ---
# Dashboard Stripe → Développeurs → Clés API + Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Agora (génération de tokens RTC côté serveur) ---
# Dashboard Agora → Project Management (App ID + App Certificate primaire)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
